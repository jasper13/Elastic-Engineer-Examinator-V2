  {
    "titel": "Diagnose and repair shard issues",
    "domein": "Cluster Management",
    "opdracht": "An index `ece-yellow` is staged with 1 replica, which stays yellow on a single node because the replica cannot be allocated. Repair cluster health by removing the replica so the index becomes green.",
    "hint": "number_of_replicas can change dynamically: PUT /ece-yellow/_settings with number_of_replicas 0. Confirm via GET /_cluster/health/ece-yellow.",
    "modelantwoord": "PUT /ece-yellow/_settings\n{\n  \"index\": { \"number_of_replicas\": 0 }\n}",
    "checks": [
      {
        "naam": "0 replicas",
        "methode": "GET",
        "pad": "/ece-yellow/_settings",
        "verwachting": {
          "type": "json",
          "pad": "ece-yellow.settings.index.number_of_replicas",
          "operator": "eq",
          "waarde": "0"
        }
      },
      {
        "naam": "Index is green",
        "methode": "GET",
        "pad": "/_cluster/health/ece-yellow",
        "verwachting": {
          "type": "json",
          "pad": "status",
          "operator": "eq",
          "waarde": "green"
        }
      }
    ],
    "setup": [
      {
        "naam": "Create yellow index",
        "methode": "PUT",
        "pad": "/ece-yellow",
