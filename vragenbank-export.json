[
  {
    "titel": "Define an index from requirements",
    "domein": "Data Management",
    "opdracht": "Create an index `ece-index-req` that satisfies these requirements: 3 primary shards, 1 replica, and a refresh interval of 30 seconds.",
    "hint": "Put everything in the settings block: number_of_shards, number_of_replicas and refresh_interval.",
    "modelantwoord": "PUT /ece-index-req\n{\n  \"settings\": {\n    \"number_of_shards\": 3,\n    \"number_of_replicas\": 1,\n    \"refresh_interval\": \"30s\"\n  }\n}",
    "checks": [
      {
        "naam": "Index exists",
        "methode": "HEAD",
        "pad": "/ece-index-req",
        "verwachting": {
          "type": "status"
        }
      },
      {
        "naam": "3 primary shards",
        "methode": "GET",
        "pad": "/ece-index-req/_settings",
        "verwachting": {
          "type": "json",
          "pad": "ece-index-req.settings.index.number_of_shards",
          "operator": "eq",
          "waarde": "3"
        }
      },
      {
        "naam": "Refresh interval 30s",
        "methode": "GET",
        "pad": "/ece-index-req/_settings",
        "verwachting": {
          "type": "json",
          "pad": "ece-index-req.settings.index.refresh_interval",
          "operator": "eq",
          "waarde": "30s"
        }
      }
    ]
  },
  {
    "titel": "Dynamic template",
    "domein": "Data Management",
    "opdracht": "Create an index `ece-dyn` with a dynamic template that maps every string field to `keyword` instead of the default text/keyword multi-field.",
    "hint": "Use mappings.dynamic_templates with match_mapping_type \"string\" and a mapping of type keyword.",
    "modelantwoord": "PUT /ece-dyn\n{\n  \"mappings\": {\n    \"dynamic_templates\": [\n      { \"strings_as_keywords\": {\n          \"match_mapping_type\": \"string\",\n          \"mapping\": { \"type\": \"keyword\" }\n      } }\n    ]\n  }\n}",
    "checks": [
      {
        "naam": "Index exists",
        "methode": "HEAD",
        "pad": "/ece-dyn",
        "verwachting": {
          "type": "status"
        }
      },
      {
        "naam": "Dynamic template present",
        "methode": "GET",
        "pad": "/ece-dyn/_mapping",
        "verwachting": {
          "type": "json",
          "pad": "ece-dyn.mappings.dynamic_templates.0",
          "operator": "exists"
        }
      },
      {
        "naam": "Maps strings to keyword",
        "methode": "GET",
        "pad": "/ece-dyn/_mapping",
        "verwachting": {
          "type": "json",
          "pad": "ece-dyn.mappings.dynamic_templates.0.strings_as_keywords.mapping.type",
          "operator": "eq",
          "waarde": "keyword"
        }
      }
    ]
  },
  {
    "titel": "ILM policy for a time-series index",
    "domein": "Data Management",
    "opdracht": "Create an ILM policy `ece-ts-policy` for a time-series index: a hot phase that rolls over at 50 GB or 30 days, a warm phase after 7 days, and a delete phase after 90 days.",
    "hint": "phases.hot.actions.rollover (max_primary_shard_size/max_age), phases.warm.min_age, phases.delete.min_age with a delete action.",
    "modelantwoord": "PUT _ilm/policy/ece-ts-policy\n{\n  \"policy\": { \"phases\": {\n    \"hot\":  { \"actions\": { \"rollover\": { \"max_primary_shard_size\": \"50gb\", \"max_age\": \"30d\" } } },\n    \"warm\": { \"min_age\": \"7d\", \"actions\": {} },\n    \"delete\": { \"min_age\": \"90d\", \"actions\": { \"delete\": {} } }\n  } }\n}",
    "checks": [
      {
        "naam": "Policy exists",
        "methode": "GET",
        "pad": "/_ilm/policy/ece-ts-policy",
        "verwachting": {
          "type": "status"
        }
      },
      {
        "naam": "Hot phase has rollover",
        "methode": "GET",
        "pad": "/_ilm/policy/ece-ts-policy",
        "verwachting": {
          "type": "json",
          "pad": "ece-ts-policy.policy.phases.hot.actions.rollover",
          "operator": "exists"
        }
      },
      {
        "naam": "Delete after 90 days",
        "methode": "GET",
        "pad": "/_ilm/policy/ece-ts-policy",
        "verwachting": {
          "type": "json",
          "pad": "ece-ts-policy.policy.phases.delete.min_age",
          "operator": "eq",
          "waarde": "90d"
        }
      }
    ]
  },
  {
    "titel": "Index template that creates a data stream",
    "domein": "Data Management",
    "opdracht": "Create an index template `ece-ds-template` for pattern `ece-stream-*` that enables data streams, then create the data stream `ece-stream-logs`.",
    "hint": "The template needs an empty \"data_stream\": {} block and a priority. Then PUT _data_stream/ece-stream-logs.",
    "modelantwoord": "PUT _index_template/ece-ds-template\n{\n  \"index_patterns\": [\"ece-stream-*\"],\n  \"data_stream\": {},\n  \"priority\": 200\n}\n\nPUT _data_stream/ece-stream-logs",
    "checks": [
      {
        "naam": "Template exists",
        "methode": "GET",
        "pad": "/_index_template/ece-ds-template",
        "verwachting": {
          "type": "status"
        }
      },
      {
        "naam": "Template enables data streams",
        "methode": "GET",
        "pad": "/_index_template/ece-ds-template",
        "verwachting": {
          "type": "json",
          "pad": "index_templates.0.index_template.data_stream",
          "operator": "exists"
        }
      },
      {
        "naam": "Data stream exists",
        "methode": "GET",
        "pad": "/_data_stream/ece-stream-logs",
        "verwachting": {
          "type": "json",
          "pad": "data_streams.0.name",
          "operator": "eq",
          "waarde": "ece-stream-logs"
        }
      }
    ]
  },
  {
    "titel": "Search for terms and phrases",
    "domein": "Searching Data",
    "opdracht": "Test data will be staged in `ece-articles`. Run a match_phrase query on the `body` field for the exact phrase \"machine learning\" and confirm it returns exactly 2 documents.",
    "hint": "Use GET /ece-articles/_search with a match_phrase query, or _count to verify the number of hits.",
    "modelantwoord": "GET /ece-articles/_search\n{\n  \"query\": { \"match_phrase\": { \"body\": \"machine learning\" } }\n}",
    "checks": [
      {
        "naam": "Phrase matches exactly 2 docs",
        "methode": "GET",
        "pad": "/ece-articles/_count",
        "body": {
          "query": {
            "match_phrase": {
              "body": "machine learning"
            }
          }
        },
        "verwachting": {
          "type": "json",
          "pad": "count",
          "operator": "eq",
          "waarde": 2
        }
      }
    ],
    "setup": [
      {
        "naam": "Stage articles",
        "methode": "PUT",
        "pad": "/ece-articles/_bulk?refresh=true",
        "body": "{\"index\":{\"_id\":\"1\"}}\n{\"body\":\"an introduction to machine learning\"}\n{\"index\":{\"_id\":\"2\"}}\n{\"body\":\"deep learning and machine vision\"}\n{\"index\":{\"_id\":\"3\"}}\n{\"body\":\"applied machine learning in practice\"}\n{\"index\":{\"_id\":\"4\"}}\n{\"body\":\"distributed systems design\"}\n"
      }
    ]
  },
  {
    "titel": "Boolean combination of queries and filters",
    "domein": "Searching Data",
    "opdracht": "Test data will be staged in `ece-products`. Write a bool query that returns products where `category` is \"electronics\" AND `price` is less than 500 (both as filters), then verify it returns exactly 2 documents.",
    "hint": "Use a bool query with two filter clauses: a term on category and a range on price with lt 500.",
    "modelantwoord": "GET /ece-products/_search\n{\n  \"query\": { \"bool\": { \"filter\": [\n    { \"term\": { \"category\": \"electronics\" } },\n    { \"range\": { \"price\": { \"lt\": 500 } } }\n  ] } }\n}",
    "checks": [
      {
        "naam": "Bool filter returns 2 docs",
        "methode": "GET",
        "pad": "/ece-products/_count",
        "body": {
          "query": {
            "bool": {
              "filter": [
                {
                  "term": {
                    "category": "electronics"
                  }
                },
                {
                  "range": {
                    "price": {
                      "lt": 500
                    }
                  }
                }
              ]
            }
          }
        },
        "verwachting": {
          "type": "json",
          "pad": "count",
          "operator": "eq",
          "waarde": 2
        }
      }
    ],
    "setup": [
      {
        "naam": "Stage products",
        "methode": "PUT",
        "pad": "/ece-products/_bulk?refresh=true",
        "body": "{\"index\":{\"_id\":\"1\"}}\n{\"category\":\"electronics\",\"price\":299,\"name\":\"webcam\"}\n{\"index\":{\"_id\":\"2\"}}\n{\"category\":\"electronics\",\"price\":450,\"name\":\"headset\"}\n{\"index\":{\"_id\":\"3\"}}\n{\"category\":\"electronics\",\"price\":899,\"name\":\"monitor\"}\n{\"index\":{\"_id\":\"4\"}}\n{\"category\":\"furniture\",\"price\":199,\"name\":\"chair\"}\n"
      }
    ]
  },
  {
    "titel": "Asynchronous search",
    "domein": "Searching Data",
    "opdracht": "Test data will be staged in `ece-events`. Submit an async search against `ece-events` running a match_all query, via the _async_search endpoint. The check verifies it works and returns results on this single node.",
    "hint": "POST /ece-events/_async_search with a query. On a small index it completes immediately (is_running false).",
    "modelantwoord": "POST /ece-events/_async_search?wait_for_completion_timeout=10s\n{\n  \"query\": { \"match_all\": {} }\n}",
    "checks": [
      {
        "naam": "Async search returns hits",
        "methode": "POST",
        "pad": "/ece-events/_async_search?wait_for_completion_timeout=10s",
        "body": {
          "query": {
            "match_all": {}
          }
        },
        "verwachting": {
          "type": "json",
          "pad": "response.hits.total.value",
          "operator": "gte",
          "waarde": 3
        }
      }
    ],
    "setup": [
      {
        "naam": "Stage events",
        "methode": "PUT",
        "pad": "/ece-events/_bulk?refresh=true",
        "body": "{\"index\":{}}\n{\"type\":\"login\"}\n{\"index\":{}}\n{\"type\":\"logout\"}\n{\"index\":{}}\n{\"type\":\"purchase\"}\n"
      }
    ]
  },
  {
    "titel": "Metric and bucket aggregations",
    "domein": "Searching Data",
    "opdracht": "Test data will be staged in `ece-sales`. Write a search (size 0) with a terms bucket aggregation named `by_region` on `region`, and verify the response contains that aggregation.",
    "hint": "Set size to 0 and add an aggs block with a terms aggregation on region.",
    "modelantwoord": "GET /ece-sales/_search\n{\n  \"size\": 0,\n  \"aggs\": { \"by_region\": { \"terms\": { \"field\": \"region\" } } }\n}",
    "checks": [
      {
        "naam": "Aggregation returns buckets",
        "methode": "POST",
        "pad": "/ece-sales/_search",
        "body": {
          "size": 0,
          "aggs": {
            "by_region": {
              "terms": {
                "field": "region"
              }
            }
          }
        },
        "verwachting": {
          "type": "json",
          "pad": "aggregations.by_region.buckets.0.key",
          "operator": "exists"
        }
      }
    ],
    "setup": [
      {
        "naam": "Stage sales",
        "methode": "PUT",
        "pad": "/ece-sales/_bulk?refresh=true",
        "body": "{\"index\":{}}\n{\"region\":\"emea\",\"amount\":120}\n{\"index\":{}}\n{\"region\":\"emea\",\"amount\":80}\n{\"index\":{}}\n{\"region\":\"apac\",\"amount\":200}\n{\"index\":{}}\n{\"region\":\"amer\",\"amount\":50}\n"
      }
    ]
  },
  {
    "titel": "Aggregations with sub-aggregations",
    "domein": "Searching Data",
    "opdracht": "Using `ece-sales` (staged for you), write a terms aggregation on `region` with a sub-aggregation `avg_amount` that averages `amount`. Verify the sub-aggregation appears in the response.",
    "hint": "Nest an aggs block inside the terms aggregation, with an avg aggregation on amount.",
    "modelantwoord": "GET /ece-sales/_search\n{\n  \"size\": 0,\n  \"aggs\": { \"by_region\": {\n    \"terms\": { \"field\": \"region\" },\n    \"aggs\": { \"avg_amount\": { \"avg\": { \"field\": \"amount\" } } }\n  } }\n}",
    "checks": [
      {
        "naam": "Sub-aggregation present",
        "methode": "POST",
        "pad": "/ece-sales/_search",
        "body": {
          "size": 0,
          "aggs": {
            "by_region": {
              "terms": {
                "field": "region"
              },
              "aggs": {
                "avg_amount": {
                  "avg": {
                    "field": "amount"
                  }
                }
              }
            }
          }
        },
        "verwachting": {
          "type": "json",
          "pad": "aggregations.by_region.buckets.0.avg_amount.value",
          "operator": "exists"
        }
      }
    ],
    "setup": [
      {
        "naam": "Stage sales",
        "methode": "PUT",
        "pad": "/ece-sales/_bulk?refresh=true",
        "body": "{\"index\":{}}\n{\"region\":\"emea\",\"amount\":120}\n{\"index\":{}}\n{\"region\":\"emea\",\"amount\":80}\n{\"index\":{}}\n{\"region\":\"apac\",\"amount\":200}\n{\"index\":{}}\n{\"region\":\"amer\",\"amount\":50}\n"
      }
    ]
  },
  {
    "titel": "Cross-cluster search",
    "domein": "Searching Data",
    "opdracht": "Cross-cluster search needs a remote cluster. Register a remote cluster `ece-remote` with seed `127.0.0.1:9300` (your own node, works single-node). The check verifies the remote is configured; a real CCS query then uses `ece-remote:index`.",
    "hint": "PUT _cluster/settings with persistent cluster.remote.ece-remote.seeds. Then search via GET /ece-remote:some-index/_search.",
    "modelantwoord": "PUT _cluster/settings\n{\n  \"persistent\": { \"cluster\": { \"remote\": {\n    \"ece-remote\": { \"seeds\": [\"127.0.0.1:9300\"] }\n  } } }\n}",
    "checks": [
      {
        "naam": "Remote cluster configured",
        "methode": "GET",
        "pad": "/_cluster/settings",
        "verwachting": {
          "type": "json",
          "pad": "persistent.cluster.remote.ece-remote.seeds.0",
          "operator": "contains",
          "waarde": "9300"
        }
      }
    ]
  },
  {
    "titel": "Search using a runtime field",
    "domein": "Searching Data",
    "opdracht": "Using `ece-products` (staged for you), run a search that defines a runtime field `price_with_tax` (price * 1.21) in the search request itself and returns it via the fields parameter. Verify the field comes back.",
    "hint": "Add runtime_mappings to the search body and list price_with_tax under \"fields\". Use emit(doc['price'].value * 1.21).",
    "modelantwoord": "GET /ece-products/_search\n{\n  \"runtime_mappings\": {\n    \"price_with_tax\": { \"type\": \"double\", \"script\": { \"source\": \"emit(doc['price'].value * 1.21)\" } }\n  },\n  \"fields\": [\"price_with_tax\"],\n  \"size\": 1\n}",
    "checks": [
      {
        "naam": "Runtime field returned",
        "methode": "POST",
        "pad": "/ece-products/_search",
        "body": {
          "runtime_mappings": {
            "price_with_tax": {
              "type": "double",
              "script": {
                "source": "emit(doc['price'].value * 1.21)"
              }
            }
          },
          "fields": [
            "price_with_tax"
          ],
          "size": 1
        },
        "verwachting": {
          "type": "json",
          "pad": "hits.hits.0.fields.price_with_tax.0",
          "operator": "exists"
        }
      }
    ],
    "setup": [
      {
        "naam": "Stage products",
        "methode": "PUT",
        "pad": "/ece-products/_bulk?refresh=true",
        "body": "{\"index\":{\"_id\":\"1\"}}\n{\"category\":\"electronics\",\"price\":299,\"name\":\"webcam\"}\n{\"index\":{\"_id\":\"2\"}}\n{\"category\":\"electronics\",\"price\":450,\"name\":\"headset\"}\n{\"index\":{\"_id\":\"3\"}}\n{\"category\":\"electronics\",\"price\":899,\"name\":\"monitor\"}\n{\"index\":{\"_id\":\"4\"}}\n{\"category\":\"furniture\",\"price\":199,\"name\":\"chair\"}\n"
      }
    ]
  },
