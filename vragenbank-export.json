  {
    "titel": "Reindex and Update By Query",
    "domein": "Data Processing",
    "opdracht": "Test data is staged in `ece-src`. Reindex it into `ece-dst`, then run update_by_query on `ece-dst` to add `processed: true` to every document. Verify ece-dst has all docs and they are processed.",
    "hint": "POST _reindex (source/dest), then POST /ece-dst/_update_by_query with script ctx._source.processed = true.",
    "modelantwoord": "POST _reindex?refresh=true\n{\n  \"source\": { \"index\": \"ece-src\" },\n  \"dest\":   { \"index\": \"ece-dst\" }\n}\n\nPOST /ece-dst/_update_by_query?refresh=true\n{\n  \"script\": { \"source\": \"ctx._source.processed = true\" }\n}",
    "checks": [
      {
        "naam": "ece-dst has 3 docs",
